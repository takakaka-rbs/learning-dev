{
  "name": "Full-Stack Dev (Vue3 + Spring + Postgres)",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "devcontainer",
  // devcontainer では db だけ起動する（backend/frontend コンテナは docker compose up 用。
  // 起動すると make dev のポート 8080/5173 と競合するため）
  "runServices": ["devcontainer", "db"],
  "workspaceFolder": "/workspace",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21",
      "installMaven": true
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "Vue.volar",
        "vmware.vscode-spring-boot",
        "redhat.java",
        "vscjava.vscode-maven",
        "42Crunch.vscode-openapi",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "anthropic.claude-code"
      ],
      "settings": {
        "java.configuration.updateBuildConfiguration": "automatic",

        // デフォルトフォーマッター（Vue・TS・JS は Prettier）
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",

        // TypeScript・Vue は ESLint の自動修正も保存時に実行
        "[typescript]": {
          "editor.codeActionsOnSave": {
            "source.fixAll.eslint": "explicit"
          }
        },
        "[vue]": {
          "editor.codeActionsOnSave": {
            "source.fixAll.eslint": "explicit"
          }
        },

        // Java は redhat.java が Google スタイルで保存時自動整形
        // google-java-format と同じ Google Java Style Guide に準拠
        "[java]": {
          "editor.defaultFormatter": "redhat.java",
          "editor.formatOnSave": true,
          "java.format.settings.url": "https://raw.githubusercontent.com/google/styleguide/gh-pages/eclipse-java-google-style.xml"
        }
      }
    }
  },
  "forwardPorts": [5173, 8080, 5432],
  "postCreateCommand": "sudo chown -R vscode:vscode /workspace && cd /workspace && npm install && cd /workspace/frontend && npm install && cd /workspace/backend && mvn dependency:resolve -q && cd /workspace && npm install -g @anthropic-ai/claude-code@latest && claude plugin marketplace add takakaka-rbs/takaka-agent-plugins && for p in orchestrator openapi-specificater requirements-specificater screen-specificater github-issue-creator git-commit-pusher plugin-improver code-implementer postgres-dev dev-knowledge-harvester backlog-manager; do claude plugin install \"$p@takaka-agent-plugins\" --scope project; done && echo '✅ Setup complete!'",
  "remoteUser": "vscode"
}
