{
  "name": "frontend",
  "version": "0.0.1",
  "private": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "type-check": "vue-tsc --noEmit",
    "format": "prettier --write src/",
    "generate:api": "openapi-ts --input ../openapi/openapi.yml --output src/api/generated --client fetch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:vrt": "playwright test -c playwright.vrt.config.ts",
    "test:e2e": "playwright test -c playwright.e2e.config.ts"
  },
  "dependencies": {
    "vue": "^3.4.0",
    "vue-router": "^4.3.0",
    "pinia": "^2.1.0",
    "@vueuse/core": "^10.0.0",
    "@hey-api/client-fetch": "^0.13.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "vite": "^5.3.0",
    "typescript": "^5.4.0",
    "vue-tsc": "^2.0.0",
    "@hey-api/openapi-ts": "^0.99.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "vitest": "^1.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "@vitest/ui": "^1.0.0",
    "jsdom": "^24.0.0",
    "@vue/test-utils": "^2.4.0",
    "storybook": "^8.6.0",
    "@storybook/vue3-vite": "^8.6.0",
    "@playwright/test": "^1.54.0",
    "http-server": "^14.1.1"
  }
}
