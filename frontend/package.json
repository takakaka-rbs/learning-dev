{
  "name": "frontend",
  "version": "0.0.1",
  "private": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.ts --fix",
    "format": "prettier --write src/",
    "generate:api": "openapi-ts --input ../openapi/openapi.yml --output src/api/generated --client fetch"
  },
  "dependencies": {
    "vue": "^3.4.0",
    "vue-router": "^4.3.0",
    "pinia": "^2.1.0",
    "@vueuse/core": "^10.0.0",
    "@hey-api/client-fetch": "^0.6.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "vite": "^5.3.0",
    "typescript": "^5.4.0",
    "vue-tsc": "^2.0.0",
    "@hey-api/openapi-ts": "^0.52.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0"
  }
}
